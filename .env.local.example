# Copy to .env.local (gitignored) and fill in real values.
# Production values live in Vercel Project Settings > Environment Variables, never in git.

# Neon Postgres connection string (https://neon.tech)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Stripe keys (https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe webhook signing secret (run: stripe listen --forward-to localhost:3000/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Public base URL used for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
