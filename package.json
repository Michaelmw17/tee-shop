{
  "name": "yogi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --config ./config/eslint.config.mjs",
    "lint:fix": "eslint --fix --config ./config/eslint.config.mjs .",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate-to-db.ts",
    "db:init": "tsx scripts/migrate-to-db.ts",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "security:check": "npm audit --audit-level=high && npm run build",
    "security:pre-commit": "npm run type-check && npm audit --audit-level=moderate && npm run lint",
    "security:scan-files": "grep -r -i -n 'password\\|secret\\|key.*=\\|token\\|api[_-]*key' --exclude-dir=node_modules --exclude-dir=.git . || echo 'No sensitive data found'",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "validate": "npm run type-check && npm run lint && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@stripe/stripe-js": "^8.2.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.544.0",
    "next": "^16.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --config ./config/eslint.config.mjs"
    ]
  },
  "volta": {
    "node": "22.22.0"
  }
}
