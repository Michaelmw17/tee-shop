# Run security audit
echo "🔒 Running security audit..."
npm audit --audit-level=moderate || true

# Warn about vulnerabilities but don't block commit
if [ $? -ne 0 ]; then
  echo "⚠️  Security vulnerabilities found! Consider running 'npm audit fix' to fix them."
  echo "💡 Or run 'npm run security:fix' to auto-fix issues"
fi

# Run lint-staged for file-specific checks
npm run pre-commit

echo "✅ Security check passed! Proceeding with commit..."
